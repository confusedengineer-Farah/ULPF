{
  "id": "custom_firewall",
  "name": "Custom Firewall",
  "vendor": "TestVendor",
  "product": "Firewall",
  "format": "cef",
  "version": "1.0",
  "match": {
    "required_fields": [
      "src",
      "dst",
      "spt",
      "dpt",
      "proto",
      "action"
    ]
  },
  "field_mappings": {
    "src": "network.source.ip",
    "dst": "network.destination.ip",
    "spt": "network.source.port",
    "dpt": "network.destination.port",
    "proto": "network.protocol",
    "action": "event.action"
  }
}