{
  "id": "cisco_asa",
  "name": "Cisco ASA",
  "vendor": "Cisco",
  "product": "ASA",
  "format": "syslog",
  "version": "1.0",
  "match": {
    "required_fields": [
      "src",
      "dst",
      "spt",
      "dpt",
      "action"
    ]
  },
  "field_mappings": {
    "src": "network.source.ip",
    "dst": "network.destination.ip",
    "spt": "network.source.port",
    "dpt": "network.destination.port",
    "action": "event.action"
  }
}